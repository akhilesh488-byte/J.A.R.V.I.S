# Copy to .env and fill in only what you use. Nothing here is required.

# --- Fully local (free, offline) ---
# LOCAL_LLM_MODEL=qwen2.5:3b        # needs Ollama running; pick a tool-capable model
WHISPER_MODEL_SIZE=small            # tiny | base | small | small.en | medium.en | large-v3-turbo | distil-large-v3
WHISPER_DEVICE=cpu                  # cpu | cuda (GTX 1650 Ti: use cuda for speed)
WHISPER_COMPUTE_TYPE=int8           # int8 | float16 | int8_float16 (use int8_float16 on CUDA)
WHISPER_LANGUAGE=en                 # en | '' for auto-detect (lock to 'en' for speed + accuracy)
WHISPER_BEAM_SIZE=5                 # higher = more accurate but slower
WHISPER_VAD_FILTER=true             # strip non-speech segments before Whisper decoding

# --- STT engine selection ---
# STT_ENGINE=faster_whisper         # faster_whisper | deepgram | openai | elevenlabs_scribe | cohere_transcribe
# STT_FALLBACK=faster_whisper       # comma-separated fallback chain

# --- Wake word (Picovoice Porcupine / openWakeWord) ---
# PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here # from https://console.picovoice.ai/
# WAKE_WORD_MODEL=hey_jarvis

# --- Microphone ---
# JARVIS_MIC_INDEX=0                # device index from: python doctor.py --mic
# VAD_RMS_THRESHOLD=500             # tune with: python doctor.py --mic

# --- Audio capture quality ---
# AUDIO_PREROLL_MS=300              # ms of audio captured before speech starts (prevents first-syllable cutoff)
# AUDIO_TRAILING_PAD_MS=200         # ms of silence appended after speech ends
# AUDIO_NORMALIZE=true              # peak-normalize quiet recordings before transcription
# TTS_POST_SPEAK_DELAY=0.3          # seconds to wait after TTS before opening mic (prevents echo)

# --- Cloud brains (optional) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6    # check against Anthropic's current model list
# OPENAI_MODEL=gpt-4o               # check against OpenAI's current model list
# JARVIS_MODEL_PRIORITY=local,claude,openai

# --- Cloud voice (optional) ---
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# --- Behaviour ---
# JARVIS_MODE=text                  # wake | ptt | text
# JARVIS_USE_MEMORY=true
# JARVIS_VOCAB_FIX=false            # fuzzy STT correction (conservative, default off)

# --- Debug ---
# JARVIS_DEBUG_AUDIO=1              # save every recording to data/recordings/ + log.jsonl
# JARVIS_SPEAKER_ID=me              # label for bakeoff CSV (optional)
